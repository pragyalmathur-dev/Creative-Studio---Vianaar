rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pragyalmathur@gmail.com' ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /profiles/{profileId} {
      // Allow searching profiles by email for login validation (Public read for allowlist check)
      allow read: if true;
      
      // Allow admins to manage profiles (create via directory)
      allow create, update, delete: if isAdmin();
      
      // Allow users to claim/update their own profile
      allow write: if isSignedIn() && (request.auth.uid == profileId || isAdmin());
    }

    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /edit_history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
